# ------------------------------------------------------------------ #
# MirrorMind — environment. Copy to .env.local and fill in.          #
# See docs/14-SETUP.md.                                              #
# ------------------------------------------------------------------ #

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
# Current key format ("sb_publishable_…"). Client-safe — access is gated by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative (a JWT). Only set this if your project still uses anon keys.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client or commit. ("service_role" JWT or "sb_secret_…")
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Project Settings → Database → Connection string → "URI") ---
# DATABASE_URL: Transaction pooler, port 6543 — used by the app.
# DATABASE_URL_UNPOOLED: Direct/Session connection, port 5432 — migrations & check:db.
# Replace [YOUR-PASSWORD] in each with your database password.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- AI provider ---------------------------------------------------- #
# auto = Gemini if GOOGLE_API_KEY set, else Anthropic if ANTHROPIC_API_KEY,
#        else deterministic offline fixtures.
# Options: auto | gemini | anthropic | ollama | fixture
AI_PROVIDER=auto

# Option A — Google Gemini (FREE tier, multimodal, works on Vercel).
#   Get a key: https://aistudio.google.com/apikey
#   Free tier note: Google may use free-tier content to improve its products.
#   Fine for building; use a paid key before real users (see docs/12).
GOOGLE_API_KEY=
# gemini-flash-lite-latest = fast, available on new keys, no reasoning overhead.
# Run `npm run probe:gemini` to see what your key can actually use.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# Chat fallback when Gemini is rate-limited — any OpenAI-compatible API
# (OpenRouter default base, or Groq). Use a free model. Unset = disabled.
# Embeddings never fall back (the vector space must stay consistent).
FALLBACK_AI_KEY=
FALLBACK_AI_BASE_URL=https://openrouter.ai/api/v1
FALLBACK_AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Option B — Anthropic (paid).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Option C — Ollama (free, local, private; NOT available on Vercel).
#   ollama pull llama3.2-vision && ollama pull llama3.1 && ollama pull bge-m3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llama3.2-vision
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=bge-m3

# Embeddings: follows AI_PROVIDER unless you set a dedicated provider+key here
# (voyage or openai). Keep EMBEDDING_DIMS in sync with the vector(n) column.
# EMBEDDING_PROVIDER=voyage
# EMBEDDING_MODEL=voyage-3.5
# EMBEDDING_API_KEY=
EMBEDDING_DIMS=1024

# 1 = fixtures only, zero external calls (offline dev / fallback)
DRY_RUN=0

# --- App behaviour ---
APP_TZ=Asia/Kolkata
# Max captures per user per day (protects the shared AI quota).
DAILY_CAPTURE_LIMIT=15
# Max chat questions per user per rolling hour.
CHAT_HOURLY_LIMIT=40
# Hard cap on total registered users. A brand-new sign-up past this is refused
# (existing users always get in). 0 = no cap.
MAX_USERS=10
# Shared ceiling on Gemini API calls per IST day across ALL users (free-tier
# safety net). Past this, new captures/questions get a "back tomorrow" notice
# instead of a hard failure. 0 = disabled. Free tier is ~1,000 req/day/project.
DAILY_AI_CALL_BUDGET=800
# "0" (default) = open sign-ups: anyone with the link can join until MAX_USERS
# seats are full; the owner frees seats from Settings › Members. "1" = closed:
# only allow-listed emails (allowed_emails table, managed in Supabase) + OWNER_EMAIL.
INVITE_ONLY=0
# Your email — unlocks /settings/access to manage the sign-up allowlist.
OWNER_EMAIL=
# Public read-only demo account. Set EMAIL + PASSWORD, run `npm run seed:demo`,
# then paste the printed id into DEMO_USER_ID (here + Vercel) to switch on the
# read-only guards and the "open the demo" button on the sign-in page.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
DEMO_USER_ID=
# Shared secret for Vercel Cron -> /api/cron/*  (any long random string).
CRON_SECRET=

# Optional: Sentry error tracking. Leave blank and the SDK is fully inert.
# Add a project at sentry.io (free tier), then set the DSN in both:
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# For source-map upload at build time (optional): a Sentry auth token + slugs.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Web Push (VAPID). `npx web-push generate-vapid-keys` → paste all three.
# Unset = the Settings push toggle is hidden and sends are no-ops.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Telegram capture bot. Create a bot with @BotFather → token + @username.
# Then register the webhook (once), passing the same secret:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<site>/api/telegram/webhook&secret_token=<SECRET>"
# Unset = the bot webhook 200s silently and the Settings row is hidden.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Optional: Slack/Discord incoming-webhook URL. Unexpected server errors get
# a compact message posted here (logs always get a structured line regardless).
ERROR_WEBHOOK_URL=

# --- Calling assistant (Twilio Voice + ConversationRelay) — see
# docs/modules/calling-assistant.md. Unset = /api/calls returns 501 and the
# Calls page shows a setup note instead of pretending to place a call.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# WebSocket server you host separately (Vercel can't hold a persistent
# connection) that runs the live conversation — see the module doc.
CONVERSATION_RELAY_WS_URL=
# Shared secret that WS handler sends back to /api/calls/[id]/complete.
CONVERSATION_RELAY_CALLBACK_SECRET=

# --- WhatsApp triage (passive Baileys listener, external process) — see
# docs/modules/whatsapp-triage.md. Unset = /api/whatsapp/sync refuses all
# requests. Generate a long random value, e.g. `openssl rand -hex 32`.
WHATSAPP_SYNC_WEBHOOK_SECRET=

# --- Email (Resend) — for due-soon reminders + weekly digest ---
# Key from https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender; "onboarding@resend.dev" works out of the box for testing.
EMAIL_FROM=MirrorMind <onboarding@resend.dev>
